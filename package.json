{
  "name": "jupiter-bot",
  "version": "1.0.0",
  "description": "Solana MEV arbitrage bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:web": "tsc --project tsconfig.web.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,js,cjs,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,js,cjs,mjs,json}\"",
    "test": "echo \"No tests configured yet\" && exit 0",
    "test:unit": "tsc --project tsconfig.json && node --test \"dist/**/*.test.js\"",
    "test:integration": "tsc --project tsconfig.tests.json && node --test \"dist-tests/tests/integration/*.test.js\"",
    "test:e2e": "tsc --project tsconfig.tests.json && node --test \"dist-tests/tests/e2e/*.e2e.js\"",
    "test:acceptance": "tsc --project tsconfig.tests.json && node --test \"dist-tests/tests/*.test.js\"",
    "serve:dashboard": "npm run build && npm run build:web && node dist/devDashboard.js"
  },
  "keywords": [
    "solana",
    "mev",
    "arbitrage",
    "typescript"
  ],
  "author": "ybotet21",
  "license": "ISC",
  "private": true,
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@jup-ag/api": "^6.0.48",
    "@solana/web3.js": "^1.98.4",
    "@types/express": "^4.17.21",
    "bs58": "^6.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jito-ts": "^2.2.0",
    "node-fetch": "^2.7.0",
    "pino": "^10.3.1",
    "pino-roll": "^3.1.0"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.15",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
